<?xml version="1.0"?>
<!-- Lane obstacle for the multi-object avoidance axis (2026-09-22).
     Origin is at GROUND level so the collector can teleport every fleet
     member with the same z (OB_Z) it uses for the hatchbacks. -->
<sdf version="1.9">
  <model name="ob_barrier">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.5 0 0 0</pose>
      <visual name="v_body"><geometry><box><size>0.5 2.4 1.0</size></box></geometry>
        <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
      <visual name="v_stripe1"><pose>0.26 -0.8 0 0 0 0</pose><geometry><box><size>0.02 0.5 1.0</size></box></geometry>
        <material><ambient>1 0.3 0 1</ambient><diffuse>1 0.35 0 1</diffuse></material></visual>
      <visual name="v_stripe2"><pose>0.26 0.0 0 0 0 0</pose><geometry><box><size>0.02 0.5 1.0</size></box></geometry>
        <material><ambient>1 0.3 0 1</ambient><diffuse>1 0.35 0 1</diffuse></material></visual>
      <visual name="v_stripe3"><pose>0.26 0.8 0 0 0 0</pose><geometry><box><size>0.02 0.5 1.0</size></box></geometry>
        <material><ambient>1 0.3 0 1</ambient><diffuse>1 0.35 0 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.5 2.4 1.0</size></box></geometry></collision>
    </link>
  </model>
</sdf>
