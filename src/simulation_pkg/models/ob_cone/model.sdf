<?xml version="1.0"?>
<!-- Lane obstacle for the multi-object avoidance axis (2026-09-22).
     Origin is at GROUND level so the collector can teleport every fleet
     member with the same z (OB_Z) it uses for the hatchbacks. -->
<sdf version="1.9">
  <model name="ob_cone">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.9 0 0 0</pose>
      <visual name="v"><geometry><cone><radius>0.6</radius><length>1.8</length></cone></geometry>
        <material><ambient>1 0.35 0 1</ambient><diffuse>1 0.4 0 1</diffuse><specular>0.3 0.1 0 1</specular></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.6</radius><length>1.8</length></cylinder></geometry></collision>
    </link>
  </model>
</sdf>
