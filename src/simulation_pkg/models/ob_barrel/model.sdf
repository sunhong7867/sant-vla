<?xml version="1.0"?>
<!-- Lane obstacle for the multi-object avoidance axis (2026-09-22).
     Origin is at GROUND level so the collector can teleport every fleet
     member with the same z (OB_Z) it uses for the hatchbacks. -->
<sdf version="1.9">
  <model name="ob_barrel">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.6 0 0 0</pose>
      <visual name="v"><geometry><cylinder><radius>0.5</radius><length>1.2</length></cylinder></geometry>
        <material><ambient>0.05 0.25 0.75 1</ambient><diffuse>0.08 0.32 0.85 1</diffuse><specular>0.3 0.3 0.3 1</specular></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.5</radius><length>1.2</length></cylinder></geometry></collision>
    </link>
  </model>
</sdf>
