<?xml version="1.0"?>
<!-- Lane obstacle for the multi-object avoidance axis (2026-09-22).
     Origin is at GROUND level so the collector can teleport every fleet
     member with the same z (OB_Z) it uses for the hatchbacks. -->
<sdf version="1.9">
  <model name="ob_box">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.7 0 0 0</pose>
      <visual name="v"><geometry><box><size>1.6 1.6 1.4</size></box></geometry>
        <material><ambient>0.55 0.36 0.16 1</ambient><diffuse>0.62 0.42 0.20 1</diffuse><specular>0.1 0.1 0.1 1</specular></material></visual>
      <collision name="c"><geometry><box><size>1.6 1.6 1.4</size></box></geometry></collision>
    </link>
  </model>
</sdf>
