    <!--  -->

    <link name='camera_frame'>
      <inertial>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
        <pose>0 0 0 0 -0 0</pose>
        <mass>1</mass>
      </inertial>
      <pose>-0.00031 0.318688 2.04993 0 0.1 -1.57</pose>
      <sensor name='camera' type='camera'>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <update_rate>30</update_rate>
        <topic>camera</topic>
        <camera name='prius_cam'>
          <horizontal_fov>1.0856</horizontal_fov> <!-- fov -->
          <image>
            <width>640</width> <!-- TODO 1280 720 --> 
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>

      </sensor>

      <!--
        Wide camera for VLA training. A SECOND sensor rather than a change to
        `prius_cam`, because the YOLO lane pipeline (track_rois.json,
        lane_info_extractor) is calibrated against that view and the 619-episode
        corpus was recorded through it. Both stay valid.

        Why it exists: with the 62 deg lens, the parking bay the car is turning
        into is 45 deg off-axis at the moment of the turn — outside the 31 deg
        half-angle, so the decisive frame does not contain the target. A policy
        could then only learn "turn right after N metres", which is memorised
        timing, not language grounded in the image.

          100 deg hfov -> 50 deg half-angle
          83.6 deg vfov (widening hfov widens this too)

        The useful cue is not the target bay itself, which sits at the extreme
        right edge even at 100 deg. It is how many bay openings remain ahead:
        at the bay2 turn-in those are 30.6 and 22.7 deg off-axis, comfortably in
        frame here and outside the narrow lens's 31 deg half-angle. Counting
        what is left is a single-frame cue; counting what has gone past is not.

        Position, not just angle. Pitching the roof camera down far enough to
        cut the sky filled the lower HALF of the frame with the car's own bonnet
        and cockpit — trading one dead region for a bigger one. Moving the
        sensor 2.6 m forward along its own axis puts it at the front bumper
        (the model's nose is at y = -2.24), where there is no bodywork to see.

        Measured on the ring, fraction of frame carrying information:

          narrow lens, roof   52%   (48% sky)
          this one            71%   (29% sky, 0% bodywork)

        Pose is relative to `camera_frame`, which already carries 0.1 rad of
        down-pitch, so 0.30 here gives 0.40 rad (22.9 deg) total.
      -->
      <sensor name='vla_camera' type='camera'>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <update_rate>30</update_rate>
        <topic>vla_camera</topic>
        <pose>2.6 0 -0.85 0 0.30 0</pose>
        <camera name='vla_cam'>
          <horizontal_fov>1.74533</horizontal_fov> <!-- 100 deg -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
      <gravity>1</gravity>

      <visual name='visual'>
        <geometry>
          <box>
            <size>0.1 0.5 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <pose>0 0 0 0 -0 0</pose>
        <transparency>0</transparency>
        <cast_shadows>1</cast_shadows>
      </visual>

      <collision name='collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
            <torsional>
              <coefficient>1</coefficient>
              <patch_radius>0</patch_radius>
              <surface_radius>0</surface_radius>
              <use_patch_radius>1</use_patch_radius>
              <ode>
                <slip>0</slip>
              </ode>
            </torsional>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>1e+06</threshold>
          </bounce>
          <contact>
            <collide_without_contact>0</collide_without_contact>
            <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
            <collide_bitmask>1</collide_bitmask>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0</min_depth>
            </ode>
            <bullet>
              <split_impulse>1</split_impulse>
              <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
            </bullet>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name='camera_joint' type='fixed'>
      <parent>chassis</parent>
      <child>camera_frame</child>
      <pose>0 0 0 0 -0 0</pose>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <link name='top_camera_frame'>
      <inertial>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
        <pose>0 0 0 0 -0 0</pose>
        <mass>1</mass>
      </inertial>
      <pose>-0.2 0.3 6.4 0 1.5708 -1.5708</pose>
      <sensor name='ego_top_camera' type='camera'>
        <always_on>1</always_on>
        <visualize>0</visualize>
        <update_rate>10</update_rate>
        <topic>ego_top_camera</topic>
        <camera name='top_prius_cam'>
          <horizontal_fov>1.48</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>30</far>
          </clip>
        </camera>
      </sensor>
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
      <gravity>0</gravity>
    </link>

    <joint name='top_camera_joint' type='fixed'>
      <parent>chassis</parent>
      <child>top_camera_frame</child>
      <pose>0 0 0 0 -0 0</pose>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <link name='rear_camera_frame'>
      <inertial>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
        <pose>0 0 0 0 -0 0</pose>
        <mass>1</mass>
      </inertial>
      <pose>-0.000331 0.570777 1.96618 6e-06 0.304758 1.57112</pose>
      <sensor name='rear_camera' type='camera'>
        <always_on>0</always_on>
        <visualize>0</visualize>
        <update_rate>5</update_rate>
        <topic>rear_camera</topic>
        <camera name='rear_prius_cam'>
          <horizontal_fov>1.0856</horizontal_fov>
          <image>
            <width>640</width> <!-- TODO 1280 720 --> 
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.03</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
      <gravity>1</gravity>
      <visual name='visual'>
        <geometry>
          <box>
            <size>0.1 0.5 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <pose>0 0 0 0 -0 0</pose>
        <transparency>0</transparency>
        <cast_shadows>1</cast_shadows>
      </visual>
      <collision name='collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <box>
            <size>0.1 0.1 0.1</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1</mu>
              <mu2>1</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
            <torsional>
              <coefficient>1</coefficient>
              <patch_radius>0</patch_radius>
              <surface_radius>0</surface_radius>
              <use_patch_radius>1</use_patch_radius>
              <ode>
                <slip>0</slip>
              </ode>
            </torsional>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>1e+06</threshold>
          </bounce>
          <contact>
            <collide_without_contact>0</collide_without_contact>
            <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
            <collide_bitmask>1</collide_bitmask>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0</min_depth>
            </ode>
            <bullet>
              <split_impulse>1</split_impulse>
              <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
            </bullet>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name='rear_camera_joint' type='fixed'>
      <parent>chassis</parent>
      <child>rear_camera_frame</child>
      <pose>0 0 0 0 -0 0</pose>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>

    <!--  -->

    <link name='lidar_link'>
      <inertial>
        <pose>0 -1.9 1 0 -0 0</pose>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
        <mass>0.114</mass>
      </inertial>

      <sensor name='lidar' type='gpu_lidar'>
        <!-- 라이다 시각화 빔 조절 -->
        <pose>0 0 0.0 0 0 0</pose> 
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>5</update_rate>
        <topic>scan</topic>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.28</max_angle>
              <!-- 라이다 각도값을 늘림-->
            </horizontal>
            <vertical>
              <samples>1</samples>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.12</min>
            <!-- 라이다 거리값을 늘림-->
            <max>12.0</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>

      </sensor>
      <self_collide>0</self_collide>
      <enable_wind>0</enable_wind>
      <kinematic>0</kinematic>
      <pose>8e-06 2.60856 0.829644 0 -0 0</pose>
      <gravity>1</gravity>

      <visual name='lidar_visual'>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0508</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
          <specular>0 0 0 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
        <transparency>0</transparency>
        <cast_shadows>1</cast_shadows>
      </visual>

      <collision name='lidar_collision'>
        <laser_retro>0</laser_retro>
        <max_contacts>10</max_contacts>
        <pose>0 0 0 0 -0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.0508</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.5</mu> <!-- 마찰 계수 증가 -->
              <mu2>1.5</mu2> <!-- 두 번째 마찰 계수 -->
              <mu2>1</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0</slip1>
              <slip2>0</slip2>
            </ode>
            <torsional>
              <coefficient>1</coefficient>
              <patch_radius>0</patch_radius>
              <surface_radius>0</surface_radius>
              <use_patch_radius>1</use_patch_radius>
              <ode>
                <slip>0</slip>
              </ode>
            </torsional>
          </friction>
          <bounce>
            <restitution_coefficient>0</restitution_coefficient>
            <threshold>1e+06</threshold>
          </bounce>
          <contact>
            <collide_without_contact>0</collide_without_contact>
            <collide_without_contact_bitmask>1</collide_without_contact_bitmask>
            <collide_bitmask>1</collide_bitmask>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0</min_depth>
            </ode>
            <bullet>
              <split_impulse>1</split_impulse>
              <split_impulse_penetration_threshold>-0.01</split_impulse_penetration_threshold>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+13</kp>
              <kd>1</kd>
            </bullet>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name='lidar_joint' type='fixed'>
      <parent>chassis</parent>
      <child>lidar_link</child>
      <pose>0 0 0 0 -0 0</pose>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>    

    <!-- Preserve the original learned-policy dynamics. DiffDrive owns vehicle
         motion; the front steering controllers below are visual only because
         the wheel collision shapes are spheres. -->
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>1.3345</wheel_separation>
      <wheel_radius>0.2657525</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>5</max_linear_acceleration>
      <min_linear_acceleration>-5</min_linear_acceleration>
      <max_angular_acceleration>3</max_angular_acceleration>
      <min_angular_acceleration>-3</min_angular_acceleration>
      <max_linear_velocity>8</max_linear_velocity>
      <min_linear_velocity>-8</min_linear_velocity>
      <max_angular_velocity>2</max_angular_velocity>
      <min_angular_velocity>-2</min_angular_velocity>
      <topic>/model/ego_vehicle/cmd_vel</topic>
      <odom_topic>/model/ego_vehicle/odometry</odom_topic>
    </plugin>

    <!-- Both controllers subscribe to exactly the same desired angle.  The
         front wheels can therefore only point in the same direction. -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>front_left_combined_joint</joint_name>
      <joint_index>0</joint_index>
      <topic>/model/ego_vehicle/front_steer_cmd</topic>
      <p_gain>1500</p_gain>
      <d_gain>100</d_gain>
      <cmd_max>10000</cmd_max>
      <cmd_min>-10000</cmd_min>
      <initial_position>0</initial_position>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_combined_joint</joint_name>
      <joint_name>front_right_combined_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
    </plugin>
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>front_right_combined_joint</joint_name>
      <joint_index>0</joint_index>
      <topic>/model/ego_vehicle/front_steer_cmd</topic>
      <p_gain>1500</p_gain>
      <d_gain>100</d_gain>
      <cmd_max>10000</cmd_max>
      <cmd_min>-10000</cmd_min>
      <initial_position>0</initial_position>
    </plugin>

    <link name="base_link">
      <pose>-0.03203 -2.29584 0.02306 -0 -0 -1.5708</pose>
    </link>

    <joint name="base_link_connection" type="fixed">
      <parent>chassis</parent> 
      <child>base_link</child> 
      <pose>0 0 0 0 -0 0</pose>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </limit>
          <suspension>
            <cfm>0</cfm>
            <erp>0.2</erp>
          </suspension>
        </ode>
      </physics>
    </joint>
  </model>
</sdf>
  
